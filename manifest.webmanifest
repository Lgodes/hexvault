{
  "id": "/",
  "name": "HexVault",
  "short_name": "HexVault",
  "description": "MTG collection, deck analysis, scanner, rules and life counter.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": {"client_mode": "navigate-existing"},
  "background_color": "#080b12",
  "theme_color": "#080b12",
  "orientation": "any",
  "icons": [
    {"src":"/icons/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"/icons/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},
    {"src":"/icons/maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}
  ],
  "shortcuts": [
    {"name":"Scan cards","short_name":"Scan","url":"/#scan","icons":[{"src":"/icons/icon-192.png","sizes":"192x192"}]},
    {"name":"Collection","short_name":"Collection","url":"/#collection","icons":[{"src":"/icons/icon-192.png","sizes":"192x192"}]},
    {"name":"Decks","short_name":"Decks","url":"/#decks","icons":[{"src":"/icons/icon-192.png","sizes":"192x192"}]}
  ]
}
